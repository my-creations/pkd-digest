---
layout: layouts/base.njk
permalink: /pt/
translationKey: home
pageType: home
eleventyComputed:
  title: "{{ site.title.pt }}"
  description: "{{ site.description.pt }}"
---
{% set t = i18n.pt %}
{% set locale = 'pt' %}

<section class="hero">
  <p class="eyebrow">{{ t.home.eyebrow }}</p>
  <h1>{{ t.home.headline }}</h1>
  <p class="lede">{{ t.home.lede }}</p>
  <p class="audiences">{{ t.home.audiences }}</p>
  <div class="hero__actions">
    <a class="button button--primary" href="{{ '/pt/digest/' | url }}">{{ t.home.ctaDigest }}</a>
    <a class="button button--secondary" href="{{ '/pt/timeline/' | url }}">{{ t.home.ctaTimeline }}</a>
  </div>
</section>

{% set latest = collections.latestIssueItems %}
{% if latest.length %}
  {% set latestIssue = latest[0].data.issue %}
  <section class="section section--latest" aria-labelledby="latest-heading">
    <p class="eyebrow">{{ t.home.latestKicker }}</p>
    <h2 id="latest-heading">{{ t.home.latestTitle }}</h2>
    <div class="digest-shell">
      <aside class="digest-rail" aria-label="{{ t.digest.inThisIssue }}{% if latestIssue %} {{ latestIssue }}{% endif %}">
        <h2>{{ t.digest.inThisIssue }}{% if latestIssue %} · {{ latestIssue }}{% endif %}</h2>
        <ol>
          {% for item in latest %}
            <li>
              <a href="{{ '/pt/digest/' | url }}#digest-item-{{ loop.index }}"><b>{{ loop.index }}.</b> {{ item.data.title | localized(locale) | truncate(48) }}</a>
            </li>
          {% endfor %}
        </ol>
      </aside>
      <div class="digest-river">
        <p class="lede">{{ t.home.latestBody }}</p>
        <p><a class="button button--primary" href="{{ '/pt/digest/' | url }}">{{ t.home.ctaDigest }}</a></p>
      </div>
    </div>
  </section>
{% endif %}

<section class="section" aria-labelledby="how-heading">
  <h2 id="how-heading">{{ t.home.howTitle }}</h2>
  <p class="lede">{{ t.home.howIntro }}</p>
  <ul class="feature-list">
    <li><strong>{{ t.home.howPlainLabel }}</strong> — {{ t.home.howPlainText }}</li>
    <li><strong>{{ t.home.howClinicalLabel }}</strong> — {{ t.home.howClinicalText }}</li>
    <li><strong>{{ t.home.howAskLabel }}</strong> — {{ t.home.howAskText }}</li>
  </ul>
  <p>{{ t.home.howScope }}</p>
  <p>{{ t.home.howUse }}</p>
  <p>{{ t.home.howSafety }}</p>
  <p><a class="button button--primary" href="{{ locale | sectionHref('start-here') | url }}">{{ t.home.howGuideLink }}</a></p>
</section>

<section class="section section--muted">
  <h2>{{ t.home.curationTitle }}</h2>
  <p>{{ t.home.curationBody }}</p>
</section>
