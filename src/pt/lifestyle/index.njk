<section class="section">
  <h2>{{ t.lifestyle.waterTitle }}</h2>
  <p>{{ t.lifestyle.waterBody }}</p>
</section>

<section class="section">
  <h2>{{ t.lifestyle.activityTitle }}</h2>
  <p>{{ t.lifestyle.activityBody }}</p>
</section>

<section class="section">
  <h2>{{ t.lifestyle.foodTitle }}</h2>
  <p>{{ t.lifestyle.foodBody }}</p>
</section>

<section class="section">
  <h2>{{ t.lifestyle.ketoTitle }}</h2>
  <p>{{ t.lifestyle.ketoBody }}</p>
</section>

