---
layout: layouts/base.njk
permalink: /pt/digest/
translationKey: digest
pageType: digest
eleventyComputed:
  title: "{{ i18n.pt.digest.title }}"
  description: "{{ i18n.pt.digest.lede }}"
---
{% set t = i18n.pt %}
{% set locale = 'pt' %}
{% set items = collections.latestIssueItems %}
{% set latestIssue = items.length and items[0].data.issue %}

<section class="page-header">
  <h1>{{ t.digest.title }}</h1>
  <p class="lede">{{ t.digest.lede }}</p>
  {% if latestIssue %}
    <p class="issue-label">{{ t.digest.issueLabel }} <strong>{{ latestIssue }}</strong></p>
  {% endif %}
</section>

<section class="section">
  {% if items.length %}
    <div class="card-stack">
      {% for item in items %}
        {% include "partials/item-card.njk" %}
      {% endfor %}
    </div>
  {% else %}
    <p class="empty">{{ t.digest.empty }}</p>
  {% endif %}
</section>
