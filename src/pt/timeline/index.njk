---
layout: layouts/base.njk
permalink: /pt/timeline/
translationKey: timeline
pageType: timeline
eleventyComputed:
  title: "{{ i18n.pt.timeline.title }}"
  description: "{{ i18n.pt.timeline.lede }}"
---
{% set t = i18n.pt %}
{% set locale = 'pt' %}

<section class="page-header">
  <h1>{{ t.timeline.title }}</h1>
  <p class="lede">{{ t.timeline.lede }}</p>
</section>

<section class="section">
  {% set items = collections.publishedItems %}
  {% if items.length %}
    <ol class="timeline-list">
      {% for item in items %}
        <li>
          {% include "partials/item-card.njk" %}
        </li>
      {% endfor %}
    </ol>
  {% else %}
    <p class="empty">{{ t.timeline.empty }}</p>
  {% endif %}
</section>
