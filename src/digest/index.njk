---
layout: layouts/base.njk
permalink: /digest/
translationKey: digest
pageType: digest
eleventyComputed:
  title: "{{ i18n.en.digest.title }}"
  description: "{{ i18n.en.digest.lede }}"
---
{% set t = i18n.en %}
{% set locale = 'en' %}
{% set items = collections.latestIssueItems %}
{% set latestIssue = items.length and items[0].data.issue %}

<section class="page-header">
  <h1>{{ t.digest.title }}</h1>
  <p class="lede">{{ t.digest.lede }}</p>
</section>

{% if items.length %}
  {% set lead = items[0] %}
  {% set leadSummary = lead.data.summary | localized(locale) %}
  {% set leadClinical = lead.data.clinicalNote | localized(locale) %}
  <p class="digest-dateline">
    {% if latestIssue %}
      <span>{{ t.digest.issueLabel }} <strong>{{ latestIssue }}</strong></span>
    {% endif %}
    <span>{{ t.footer.notMedicalAdvice }}</span>
  </p>

  {% include "partials/filters.njk" %}

  <div class="digest-shell">
    <aside class="digest-rail" aria-label="{{ t.digest.inThisIssue }}">
      <h2>{{ t.digest.inThisIssue }}</h2>
      <ol>
        {% for item in items %}
          <li data-rail-item="{{ loop.index }}">
            <a href="#digest-item-{{ loop.index }}"><b>{{ loop.index }}.</b> {{ item.data.title | localized(locale) | truncate(48) }}</a>
          </li>
        {% endfor %}
      </ol>
    </aside>

    <div class="digest-river">
      <article class="digest-lead" id="digest-item-1" data-filterable data-filter-index="1" data-tags="{{ lead.data.tags | join(' ') }}" data-audience="{{ lead.data.audience | join(' ') }}">
        <p class="digest-kicker">{{ t.digest.leadStory }} · 1 · <time datetime="{{ lead.date | isoDate }}">{{ lead.date | displayDate(locale) }}</time></p>
        <h2><a class="digest-link" href="{{ locale | cardHref(lead.fileSlug) | url }}">{{ lead.data.title | localized(locale) }}</a></h2>
        <div class="dual" data-dual>
          <div class="dual__switch" role="group" aria-label="{{ t.digest.dualLabel }}">
            <button type="button" class="dual__btn is-active" data-dual-view="plain" aria-pressed="true">{{ t.digest.plainLabel }}</button>
            <button type="button" class="dual__btn" data-dual-view="clinical" aria-pressed="false">{{ t.digest.clinicalLabel }}</button>
          </div>
          <p class="digest-standfirst" data-dual-panel="plain">{{ leadSummary }}</p>
          <div class="digest-clinical" data-dual-panel="clinical" hidden>
            <p>{{ leadClinical }}</p>
          </div>
        </div>
        {# Visit question: optional bilingual patient prompt. #}
        {% if lead.data.visitQuestion %}
          <section class="item-card__block" data-visit-question>
            <h3 class="item-card__label">{{ t.digest.visitQuestion }}</h3>
            <p>{{ lead.data.visitQuestion | localized(locale) | escape }}</p>
          </section>
        {% endif %}
        {# End visit question. #}
        <p class="digest-meta">
          {% if lead.data.source.url %}
            <a href="{{ lead.data.source.url }}" target="_blank" rel="noopener noreferrer">{{ lead.data.source.name or lead.data.source.url }}</a>
          {% else %}
            {{ lead.data.source.name }}
          {% endif %}
        </p>
        {% if lead.data.tags %}
          <p class="digest-tags">
            <span class="visually-hidden">{{ t.digest.tagsLabel }}: </span>
            {% for tag in lead.data.tags %}
              <span class="tag">{{ tag }}</span>
            {% endfor %}
          </p>
        {% endif %}
      </article>

      {% for item in items %}
        {% if not loop.first %}
          {% set summaryText = item.data.summary | localized(locale) %}
          {% set clinicalText = item.data.clinicalNote | localized(locale) %}
          <article class="digest-item" id="digest-item-{{ loop.index }}" data-filterable data-filter-index="{{ loop.index }}" data-tags="{{ item.data.tags | join(' ') }}" data-audience="{{ item.data.audience | join(' ') }}">
            <div class="digest-num" aria-hidden="true">{{ loop.index }}</div>
            <div>
              <p class="digest-kicker"><time datetime="{{ item.date | isoDate }}">{{ item.date | displayDate(locale) }}</time></p>
              <h3><a class="digest-link" href="{{ locale | cardHref(item.fileSlug) | url }}">{{ item.data.title | localized(locale) }}</a></h3>
              <div class="dual" data-dual>
                <div class="dual__switch" role="group" aria-label="{{ t.digest.dualLabel }}">
                  <button type="button" class="dual__btn is-active" data-dual-view="plain" aria-pressed="true">{{ t.digest.plainLabel }}</button>
                  <button type="button" class="dual__btn" data-dual-view="clinical" aria-pressed="false">{{ t.digest.clinicalLabel }}</button>
                </div>
                <p class="digest-lede" data-dual-panel="plain">{{ summaryText }}</p>
                <div class="digest-clinical" data-dual-panel="clinical" hidden>
                  <p>{{ clinicalText }}</p>
                </div>
              </div>
              {# Visit question: optional bilingual patient prompt. #}
              {% if item.data.visitQuestion %}
                <section class="item-card__block" data-visit-question>
                  <h4 class="item-card__label">{{ t.digest.visitQuestion }}</h4>
                  <p>{{ item.data.visitQuestion | localized(locale) | escape }}</p>
                </section>
              {% endif %}
              {# End visit question. #}
              <p class="digest-meta">
                {% if item.data.source.url %}
                  <a href="{{ item.data.source.url }}" target="_blank" rel="noopener noreferrer">{{ item.data.source.name or item.data.source.url }}</a>
                {% else %}
                  {{ item.data.source.name }}
                {% endif %}
              </p>
              {% if item.data.tags %}
                <p class="digest-tags">
                  <span class="visually-hidden">{{ t.digest.tagsLabel }}: </span>
                  {% for tag in item.data.tags %}
                    <span class="tag">{{ tag }}</span>
                  {% endfor %}
                </p>
              {% endif %}
            </div>
          </article>
        {% endif %}
      {% endfor %}

      <p class="digest-foot">{{ t.footer.notMedicalAdvice }}</p>
      <p class="empty" data-filters-empty hidden>{{ t.digest.filters.shownNone }}</p>
    </div>
  </div>
{% else %}
  <p class="empty">{{ t.digest.empty }}</p>
{% endif %}
