<section class="page-header">
  <p><a href="{{ locale | sectionHref('collections') | url }}">{{ t.topicBundles.back }}</a></p>
  <h1>{{ bundle.title | localized(locale) }}</h1>
  <p class="lede">{{ bundle.lede | localized(locale) }}</p>
</section>

<section class="section">
  <h2>{{ t.topicBundles.cardsTitle }}</h2>
  <ol class="archive-list">
    {% for slug in bundle.cardSlugs %}
      {% for item in collections.publishedItems %}
        {% if item.fileSlug == slug %}
          <li class="archive-issue">
            <h3><a href="{{ locale | cardHref(item.fileSlug) | url }}">{{ item.data.title | localized(locale) }}</a></h3>
            <p>{{ item.data.summary | localized(locale) }}</p>
          </li>
        {% endif %}
      {% endfor %}
    {% endfor %}
  </ol>
</section>
