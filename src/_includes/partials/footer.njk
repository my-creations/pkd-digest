{% set t = i18n[locale] %}
<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__tagline">{{ t.footer.tagline }}</p>
    <p class="site-footer__note">{{ t.footer.notMedicalAdvice }}</p>
    <p class="site-footer__meta">
      © {{ site.buildYear }}
      {% if locale == 'pt' %}{{ site.namePt }}{% else %}{{ site.name }}{% endif %}
      · {{ t.footer.copyright }}
      · <a href="{{ site.repo }}">GitHub</a>
      · <a href="{{ ('/privacy/' if locale != 'pt' else '/pt/privacy/') | url }}">{{ t.footer.privacy }}</a>
    </p>
  </div>
</footer>
