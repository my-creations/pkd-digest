{% set t = i18n[locale] %}
<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__tagline">{{ t.footer.tagline }}</p>
    <p class="site-footer__note">{{ t.footer.notMedicalAdvice }}</p>
    <p class="site-footer__links">
      <a href="mailto:{{ site.contactEmail }}">{{ t.footer.contact }}</a>
      <span aria-hidden="true">·</span>
      <a href="{{ locale | sectionHref('privacy') | url }}">{{ t.footer.privacy }}</a>
      <span aria-hidden="true">·</span>
      <a href="{{ locale | sectionHref('terms') | url }}">{{ t.footer.terms }}</a>
      <span aria-hidden="true">·</span>
      <a href="{{ locale | sectionHref('search') | url }}">{{ t.footer.search }}</a>
      <span aria-hidden="true">·</span>
      <a href="{{ locale | sectionHref('archive') | url }}">{{ t.footer.archive }}</a>
      <span aria-hidden="true">·</span>
      {# Start-here guide #}
      <a href="{{ locale | sectionHref('start-here') | url }}">{{ t.startHere.title }}</a>
      <span aria-hidden="true">·</span>
      {# End start-here guide #}
      {# Patient dictionary — begin #}
      <a href="{{ locale | sectionHref('glossary') | url }}">{{ t.glossary.title }}</a>
      <span aria-hidden="true">·</span>
      {# Patient dictionary — end #}
      <a href="{{ site.repo }}">GitHub</a>
    </p>
    <p class="site-footer__meta">
      © {{ site.buildYear }}
      {% if locale == 'pt' %}{{ site.namePt }}{% else %}{{ site.name }}{% endif %}
      · {{ t.footer.copyright }}
    </p>
  </div>
</footer>
