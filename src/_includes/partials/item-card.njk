{% set t = i18n[locale] %}
{% set summaryText = item.data.summary | localized(locale) %}
{% set clinicalText = item.data.clinicalNote | localized(locale) %}
{% set titleText = item.data.title | localized(locale) %}
<article class="item-card{% if item.data.placeholder %} item-card--placeholder{% endif %}">
  <header class="item-card__header">
    <h3 class="item-card__title">{{ titleText }}</h3>
    <p class="item-card__meta">
      <time datetime="{{ item.date | isoDate }}">{{ item.date | displayDate(locale) }}</time>
      {% if item.data.placeholder %}
        <span class="badge badge--placeholder">{{ t.digest.placeholderBadge }}</span>
      {% endif %}
      {% if item.data.status == 'draft' %}
        <span class="badge badge--draft">{{ t.digest.draftBadge }}</span>
      {% endif %}
    </p>
  </header>

  <div class="item-card__body" data-dual>
    <div class="dual__switch" role="group" aria-label="{{ t.digest.dualLabel }}">
      <button type="button" class="dual__btn is-active" data-dual-view="plain" aria-pressed="true">{{ t.digest.plainLabel }}</button>
      <button type="button" class="dual__btn" data-dual-view="clinical" aria-pressed="false">{{ t.digest.clinicalLabel }}</button>
    </div>
    <section class="item-card__block item-card__block--plain" data-dual-panel="plain">
      <h4 class="item-card__label">{{ t.digest.plainLabel }}</h4>
      <p>{{ summaryText }}</p>
    </section>
    <section class="item-card__block item-card__block--clinical" data-dual-panel="clinical" hidden>
      <h4 class="item-card__label">{{ t.digest.clinicalLabel }}</h4>
      <p>{{ clinicalText }}</p>
    </section>
  </div>

  <footer class="item-card__footer">
    {% if item.data.source %}
      <p>
        <span class="item-card__label">{{ t.digest.sourceLabel }}:</span>
        {% if item.data.source.url %}
          <a href="{{ item.data.source.url }}" target="_blank" rel="noopener noreferrer">{{ item.data.source.name or item.data.source.url }}</a>
        {% else %}
          {{ item.data.source.name }}
        {% endif %}
      </p>
    {% endif %}
    {% if item.data.tags %}
      <p class="item-card__tags">
        <span class="item-card__label">{{ t.digest.tagsLabel }}:</span>
        {% for tag in item.data.tags %}
          <span class="tag badge badge--outline">{{ tag }}</span>
        {% endfor %}
      </p>
    {% endif %}
  </footer>
</article>
