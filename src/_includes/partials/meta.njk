{% set loc = locale or site.defaultLocale %}
{% set metaTitle = title or site.title[loc] %}
{% set metaDescription = description or site.description[loc] %}
{% set canonicalUrl = site.url + (page.url | url) %}
{% set ogImageUrl = site.url + ('/assets/og-default.png' | url) %}
{% if loc == 'pt' %}
  {% set ogLocale = 'pt_PT' %}
{% else %}
  {% set ogLocale = 'en_GB' %}
{% endif %}
{% if pageType == 'digest' %}
  {% set section = 'digest' %}
{% elif pageType == 'timeline' %}
  {% set section = 'timeline' %}
{% elif pageType == 'privacy' %}
  {% set section = 'privacy' %}
{% elif pageType == 'terms' %}
  {% set section = 'terms' %}
{% else %}
  {% set section = 'home' %}
{% endif %}
{% set enHref = site.url + ('en' | sectionHref(section) | url) %}
{% set ptHref = site.url + ('pt' | sectionHref(section) | url) %}
{% if pageType == 'card' and card %}
  {% set enHref = site.url + ('en' | cardHref(card.fileSlug) | url) %}
  {% set ptHref = site.url + ('pt' | cardHref(card.fileSlug) | url) %}
{% endif %}

<title>{{ metaTitle }} · {{ site.name }}</title>
<meta name="description" content="{{ metaDescription }}" />
<link rel="canonical" href="{{ canonicalUrl }}" />

<link rel="icon" href="{{ '/assets/favicons/favicon.svg' | url }}" type="image/svg+xml" />
<link rel="icon" href="{{ '/assets/favicons/favicon-32.png' | url }}" type="image/png" sizes="32x32" />
<link rel="icon" href="{{ '/assets/favicons/favicon.ico' | url }}" sizes="any" />
<link rel="apple-touch-icon" href="{{ '/assets/favicons/apple-touch-icon.png' | url }}" sizes="180x180" />

<meta property="og:type" content="website" />
<meta property="og:title" content="{{ metaTitle }}" />
<meta property="og:description" content="{{ metaDescription }}" />
<meta property="og:url" content="{{ canonicalUrl }}" />
<meta property="og:site_name" content="{{ site.name }}" />
<meta property="og:locale" content="{{ ogLocale }}" />

<meta property="og:image" content="{{ ogImageUrl }}" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ metaTitle }}" />
<meta name="twitter:description" content="{{ metaDescription }}" />
<meta name="twitter:image" content="{{ ogImageUrl }}" />

<link rel="alternate" hreflang="en" href="{{ enHref }}" />
<link rel="alternate" hreflang="pt" href="{{ ptHref }}" />
<link rel="alternate" hreflang="x-default" href="{{ enHref }}" />
{% if pageType == 'digest' %}
<link rel="alternate" type="application/atom+xml" title="{{ metaTitle }} (Atom)" href="{{ site.url }}{{ (('/pt/feed.xml' if loc == 'pt' else '/feed.xml')) | url }}" />
{% endif %}
