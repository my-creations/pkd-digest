{
  "name": "pkd-digest",
  "version": "0.1.0",
  "description": "PKD Digest / Digest DRP — weekly bilingual EN+PT curated digest on cystic kidney disease",
  "scripts": {
    "build": "bun run validate:content && rm -rf _site && eleventy",
    "start": "rm -rf _site && eleventy --serve",
    "dev": "rm -rf _site && eleventy --serve",
    "format": "oxfmt \"**/*.{html,css,js,json,md,yml,yaml}\"",
    "format:check": "oxfmt --check \"**/*.{html,css,js,json,md,yml,yaml}\"",
    "validate:content": "bun scripts/validate-content.js",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "playwright test --config=playwright.unit.config.js",
    "test:e2e": "playwright test --config=playwright.e2e.config.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@playwright/test": "^1.63.0",
    "gray-matter": "^4.0.3",
    "oxfmt": "^0.65.0"
  },
  "packageManager": "bun@1.3.10"
}
